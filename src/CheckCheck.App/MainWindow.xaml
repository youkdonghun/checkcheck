<Window x:Class="CheckCheck.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="체크체크" Width="1160" Height="820" MinWidth="920" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#F7F8F4" Foreground="#263D33" FontFamily="Malgun Gothic" UseLayoutRounding="True">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#F0F3ED" BorderBrush="#E1E6DE" BorderThickness="0,0,1,0">
      <Grid Margin="20,26,20,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,5"><Border Background="#24664F" CornerRadius="10" Width="36" Height="36" Margin="0,0,10,0"><TextBlock Text="✓✓" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="체크체크" FontWeight="Bold" FontSize="22" VerticalAlignment="Center"/></StackPanel>
          <TextBlock Text="한 번 더, 정확하게." Foreground="#78877B" FontSize="12" Margin="1,7,0,28"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <TextBlock Text="어떻게 다듬을까요?" FontSize="11" Foreground="#7C897F" Margin="3,0,0,13"/>
          <RadioButton x:Name="MinimalMode" GroupName="Mode" IsChecked="True" Style="{StaticResource ModeButton}" Checked="ModeChanged" AutomationProperties.Name="최소 교정"><StackPanel><TextBlock Text="✓  최소 교정" FontWeight="SemiBold"/><TextBlock Text="맞춤법 · 띄어쓰기 · 오탈자" FontSize="11" Foreground="#78857C" Margin="0,5,0,0"/></StackPanel></RadioButton>
          <RadioButton x:Name="NaturalMode" GroupName="Mode" Style="{StaticResource ModeButton}" Checked="ModeChanged" AutomationProperties.Name="자연스럽게"><StackPanel><TextBlock Text="≈  자연스럽게" FontWeight="SemiBold"/><TextBlock Text="의미를 살린 편안한 문장" FontSize="11" Foreground="#78857C" Margin="0,5,0,0"/></StackPanel></RadioButton>
          <RadioButton x:Name="BusinessMode" GroupName="Mode" Style="{StaticResource ModeButton}" Checked="ModeChanged" AutomationProperties.Name="업무용 말투"><StackPanel><TextBlock Text="▤  업무용 말투" FontWeight="SemiBold"/><TextBlock Text="명확하고 정중한 표현" FontSize="11" Foreground="#78857C" Margin="0,5,0,0"/></StackPanel></RadioButton>
          <Button Content="보호할 단어 관리" Style="{StaticResource QuietButton}" Click="DictionaryClick" HorizontalAlignment="Left" Margin="4,8,0,0"/>
          <Button Content="단축키 · 편의 설정" Style="{StaticResource QuietButton}" Click="PreferencesClick" HorizontalAlignment="Left" Margin="4,2,0,0"/>
          <Button x:Name="UpdateButton" Content="최신 버전 확인" Style="{StaticResource QuietButton}" Click="UpdateClick" HorizontalAlignment="Left" Margin="4,2,0,0"/>
          <Button Content="작은 창으로 열기 ↗" Style="{StaticResource QuietButton}" Click="CompactClick" HorizontalAlignment="Left" Margin="4,2,0,0"/>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="3">
          <Border Background="#E5EBE1" CornerRadius="10" Padding="13" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="PrivacyTitle" Text="내 PC에서만 검사" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="PrivacyDescription" Text="입력한 글은 외부로&#10;전송하지 않아요." FontSize="11" Foreground="#6F7F71" Margin="0,6,0,0"/><Border BorderBrush="#CAD5C7" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0"><StackPanel><TextBlock Text="어디서든 불러오기" FontSize="11" Foreground="#6F7F71"/><TextBlock x:Name="ShortcutLabel" Text="Ctrl + Alt + Space" FontSize="12" Margin="0,4,0,0" FontWeight="SemiBold"/></StackPanel></Border></StackPanel></Border>
          <TextBlock Text="CHECKCHECK  /  0.2" FontSize="10" Foreground="#8B988C" Margin="3,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,25,28,19">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="150"/><RowDefinition Height="Auto"/><RowDefinition Height="1.45*" MinHeight="80"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="전하고 싶은 말을 더 또렷하게" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="ModeSubtitle" Text="틀린 부분만 고치고, 내 말투는 그대로 유지해요." Foreground="#77847C" FontSize="12" Margin="0,7,0,0"/></StackPanel><Button x:Name="ReviewButton" Grid.Column="1" Content="검사하기  →" Style="{StaticResource PrimaryButton}" Click="ReviewClick" MinWidth="115" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Ctrl + Enter"/></Grid>
      <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E1E7DF" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,0,13">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <RadioButton x:Name="LocalEngine" Content="로컬 AI" GroupName="Engine" IsChecked="True" Checked="EngineChanged" VerticalAlignment="Center" Foreground="#24664F" FontWeight="SemiBold" Margin="0,0,16,0"/>
          <RadioButton x:Name="BareunEngine" Grid.Column="1" Content="바른 API" GroupName="Engine" Checked="EngineChanged" VerticalAlignment="Center" Foreground="#52675A" Margin="0,0,16,0"/>
          <RadioButton x:Name="RulesEngine" Grid.Column="2" Content="간단 규칙" GroupName="Engine" Checked="EngineChanged" VerticalAlignment="Center" Foreground="#52675A" ToolTip="등록된 오탈자만 확인하는 보조 기능"/>
          <TextBlock x:Name="EngineStatus" Grid.Column="3" Text="무료 · 내 PC에서 교정" Foreground="#859186" FontSize="11" Margin="12,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <Button x:Name="ApiSetupButton" Grid.Column="4" Content="API 설정" Style="{StaticResource QuietButton}" Click="ApiSetupClick"/>
          <Button x:Name="SetupButton" Grid.Column="5" Content="AI 준비" Style="{StaticResource QuietButton}" Click="SetupClick"/>
        </Grid>
      </Border>
      <Grid Grid.Row="2" Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SourceLabel" Text="직접 입력 · 한글 / English" Foreground="#758278" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="예문" Style="{StaticResource QuietButton}" Click="SampleClick"/><Button Grid.Column="2" Content="클립보드에서 가져오기" Style="{StaticResource QuietButton}" Click="PasteClick"/></Grid>
      <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="#DCE4DC" BorderThickness="1" CornerRadius="11"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border BorderBrush="#EDF0E9" BorderThickness="0,0,0,1" Padding="15,11"><TextBlock Text="원문" FontWeight="SemiBold" FontSize="12"/></Border><TextBox x:Name="SourceEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="4" Padding="11,9" Background="Transparent" TextChanged="SourceChanged" MaxLength="10000" AutomationProperties.Name="검사할 원문"/><TextBlock x:Name="CharacterCount" Grid.Row="2" Text="0 / 10,000자" HorizontalAlignment="Right" Foreground="#97A196" FontSize="11" Margin="0,3,14,10"/></Grid></Border>
        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CCDCD0" BorderThickness="1" CornerRadius="11"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#F1F7F0" BorderBrush="#E3ECE1" BorderThickness="0,0,0,1" Padding="15,11" CornerRadius="10,10,0,0"><Grid><TextBlock Text="수정안 미리보기" FontWeight="SemiBold" FontSize="12" Foreground="#37644B"/><TextBlock Text="변경 부분 강조" HorizontalAlignment="Right" FontSize="10" Foreground="#7B987F"/></Grid></Border><RichTextBox x:Name="PreviewEditor" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="False" BorderThickness="0" Background="Transparent" Margin="4" Padding="8,6" VerticalScrollBarVisibility="Auto" FontSize="15" Foreground="#294233" FontFamily="Malgun Gothic" AutomationProperties.Name="수정안 미리보기"><FlowDocument PagePadding="3"><Paragraph Foreground="#98A396">검사하면 수정안을 여기서 확인할 수 있어요.</Paragraph></FlowDocument></RichTextBox><TextBlock x:Name="PreviewLegend" Grid.Row="2" Text="미검토 제안 포함 · 반영할 내용을 골라주세요" Foreground="#8A988A" FontSize="10" Margin="14,3,8,10" TextWrapping="Wrap"/></Grid></Border>
      </Grid>
      <Grid Grid.Row="4" Margin="0,16,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SuggestionTitle" Text="수정 제안" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CompareButton" Grid.Column="1" Content="전체 보기" Style="{StaticResource QuietButton}" Click="CompareClick"/><Button x:Name="StepButton" Grid.Column="2" Content="하나씩 검토" Style="{StaticResource QuietButton}" Click="StepClick"/><Button x:Name="UndoButton" Grid.Column="3" Content="↶ 되돌리기" Style="{StaticResource QuietButton}" Click="UndoClick" IsEnabled="False" Margin="7,0,0,0"/></Grid>
      <Border Grid.Row="5" Background="White" BorderBrush="#E1E7DE" BorderThickness="1" CornerRadius="10"><Grid><ScrollViewer x:Name="SuggestionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,5"><StackPanel x:Name="SuggestionPanel"/></ScrollViewer><StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18"><TextBlock Text="작은 실수까지, 한 번 더 체크." FontSize="14" HorizontalAlignment="Center" Foreground="#748577"/><TextBlock Text="원문을 입력하거나 선택한 글을 가져와 보세요." FontSize="12" Foreground="#98A396" Margin="0,7,0,0" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel></Grid></Border>
      <Grid Grid.Row="6" Margin="0,12,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DecisionStatus" Text="직접 입력하거나 글을 선택한 뒤 단축키를 눌러주세요." Foreground="#8B978C" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/><Button x:Name="AcceptAllButton" Grid.Column="1" Content="모두 선택" Click="AcceptAllClick" IsEnabled="False" Margin="0,0,7,0"/><Button x:Name="CopyButton" Grid.Column="2" Content="선택한 수정문 복사" Click="CopyClick" IsEnabled="False" Margin="0,0,7,0"/><Button x:Name="ApplyButton" Grid.Column="3" Content="원래 입력칸에 반영" Style="{StaticResource PrimaryButton}" Click="ApplyClick" IsEnabled="False"/></Grid>
      <Border Grid.Row="7" Background="#EEF2E9" CornerRadius="7" Padding="11,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="로컬 AI로 한글·영문을 교정해요. 처음 실행하면 무료 모델을 자동으로 내려받습니다." Foreground="#72836F" FontSize="11" TextWrapping="Wrap"/><ProgressBar x:Name="WorkProgress" Height="3" Margin="0,6,0,0" Visibility="Collapsed" Foreground="#347656" Background="#DCE7D6"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="취소" Visibility="Collapsed" Style="{StaticResource QuietButton}" Click="CancelClick" Margin="10,0,0,0"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
